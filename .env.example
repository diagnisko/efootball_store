# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="générez une valeur avec: openssl rand -base64 32"

# OAuth Google (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple (developer.apple.com)
APPLE_ID=""
APPLE_SECRET=""

# Secret partagé avec le scheduler externe (cron) qui déclenche le job de retards/pénalités.
# Générez une valeur avec: openssl rand -base64 32
CRON_SECRET=""

# Stockage cloud (AWS S3) — deux buckets distincts, jamais confondus :
#  - PUBLIC : images/vidéos de produits, servies publiquement (idéalement via un CDN devant).
#  - PRIVATE : documents d'identité et preuves de paiement, jamais d'accès public direct.
AWS_REGION="eu-north-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
S3_BUCKET_PUBLIC="vantafoot-public-hp-2026"
S3_BUCKET_PRIVATE="vantafoot-private-hp-2026"
# Optionnel : domaine CDN (CloudFront ou équivalent) devant le bucket public.
# Si vide, les URLs publiques pointent directement vers le bucket S3.
S3_PUBLIC_BASE_URL="https://vantafoot-public-hp-2026.s3.eu-north-1.amazonaws.com/"

# Emails transactionnels (Resend — resend.com). Sans cette clé, les emails sont simplement
# ignorés (avec un avertissement en log) : les notifications in-app continuent de fonctionner.
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="VANTA <no-reply@votredomaine.com>"
